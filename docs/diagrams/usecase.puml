@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam dpi 140
skinparam ArrowColor #394655
skinparam rectangleBackgroundColor #F4F6F8
skinparam classBackgroundColor #F4F6F8
skinparam usecaseBackgroundColor #F4F6F8
title Варианты использования ProCaloryAI
left to right direction
actor "Гость" as G
actor "Владелец аккаунта" as U
actor "AI Core\nПо плану" as AI
rectangle "ProCaloryAI" {
 usecase "FR-1\nЗарегистрироваться" as F1
 usecase "FR-2\nВойти и продлить доступ" as F2
 usecase "FR-3\nДобавить еду вручную" as F3
 usecase "FR-4\nДневник и удаление" as F4
 usecase "FR-5\nИтоги дня" as F5
 usecase "FR-6\nСреднее за неделю" as F6
 usecase "FR-7\nЦель и прогресс" as F7
 usecase "FR-8\nЗапись по фото — план" as F8
 usecase "FR-9\nПредпочтения питания" as F9
 usecase "FR-10\nПрофиль и показатели" as F10
}
G --> F1
G --> F2
U --> F2
U --> F3
U --> F4
U --> F5
U --> F6
U --> F7
U --> F8
U --> F9
U --> F10
AI --> F8
@enduml
